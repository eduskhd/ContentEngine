# ─────────────────────────────────────────────────────────────────
# ContentEngine — Environment Variables Template
# Copy this file to .env and fill in your credentials.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────

# ── TikTok Content Publishing API ────────────────────────────────
# Docs: https://developers.tiktok.com/doc/content-posting-api-get-started
# Start OAuth: GET http://localhost:8000/oauth/tiktok/start
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_OPEN_ID=

# ── Instagram Graph API (via Meta for Developers) ─────────────────
# Docs: https://developers.facebook.com/docs/instagram-api/guides/reels-publishing
# Start OAuth: GET http://localhost:8000/oauth/instagram/start
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

# ── YouTube Data API v3 ──────────────────────────────────────────
# Docs: https://developers.google.com/youtube/v3/docs/videos/insert
# Start OAuth: GET http://localhost:8000/oauth/youtube/start
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_ACCESS_TOKEN=
YOUTUBE_REFRESH_TOKEN=
